<?xml version="1.0"?>
<package format="3">
  <name>delivery_robot_sensor_fusion_v13</name>
  <version>0.1.0</version>
  <description>Safe V13 EKF comparison for the current delivery robot: wheel vx + nonholonomic vy=0 + MPU6500 yaw rate.</description>
  <maintainer email="robot@local.invalid">Delivery Robot Project</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
