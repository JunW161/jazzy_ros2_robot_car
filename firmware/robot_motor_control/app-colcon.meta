{
  "names": {
    "rmw_microxrcedds": {
      "cmake-args": [
        "-DRMW_UXRCE_TRANSPORT=udp",
        "-DRMW_UXRCE_MAX_NODES=1",
        "-DRMW_UXRCE_MAX_PUBLISHERS=13",
        "-DRMW_UXRCE_MAX_SUBSCRIPTIONS=10",
        "-DRMW_UXRCE_MAX_HISTORY=8",
        "-DRMW_UXRCE_STREAM_HISTORY=8",
        "-DRMW_UXRCE_XML_BUFFER_LENGTH=4096"
      ]
    }
  }
}
